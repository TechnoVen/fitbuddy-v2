<div class="landing-hero container py-5">
  <div class="row g-4 align-items-center">
    <!-- Left column: About the app (Halfmoon-inspired layout) -->
    <div class="col-lg-6">
      <div class="badge bg-primary-subtle text-primary-emphasis mb-3 rounded-pill px-3 py-2 d-inline-flex align-items-center">
        <strong class="me-2">New</strong>
        <small class="text-muted">AI-powered workout plans</small>
      </div>

      <h1 class="display-5 fw-bold mb-3">Personalized workout plans, built with AI</h1>
      <p class="lead text-muted mb-4">FitBuddy helps you create realistic, progressive, and safe workout programs tailored to your goals and equipment. Tell the assistant what you want and get an actionable plan in seconds.</p>

      <ul class="list-unstyled mb-4">
        <li class="mb-2">✅ Tailored to your goals and equipment</li>
        <li class="mb-2">✅ Progressive overload and safety-first suggestions</li>
        <li class="mb-2">✅ Easy logging and revision via chat</li>
      </ul>

      <div class="d-flex gap-2">
        <% if user_signed_in? %>
          <%= link_to "Go to my plans", workout_plans_path, class: "btn btn-primary btn-lg" %>
        <% else %>
          <%= link_to "Get started — Sign up", new_user_registration_path, class: "btn btn-primary btn-lg" %>
          <%= link_to "Try a demo", new_user_session_path, class: "btn btn-outline-secondary btn-lg" %>
        <% end %>
      </div>

      <div class="mt-5 small text-muted">
        <strong>Privacy:</strong> We never share your personal data. AI requests are handled securely via our provider.
      </div>
    </div>

    <!-- Right column: Chat/demo panel -->
    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-start mb-2">
            <div class="avatar rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width:44px;height:44px;">AI</div>
            <div>
              <h5 class="mb-0">FitBuddy Coach</h5>
              <small class="text-muted">Try a quick demo conversation</small>
            </div>
          </div>

          <div class="chat-demo border rounded p-3 mb-3 bg-light" style="min-height:180px;">
            <div class="mb-2">
              <div class="small text-muted">AI</div>
              <div class="p-2 bg-white rounded">Hi — tell me your goal, available equipment, and how many days per week you can train.</div>
            </div>

            <div>
              <div class="small text-muted">You</div>
              <div class="p-2 bg-white rounded">I want to build muscle. I have dumbbells and 4 days/week.</div>
            </div>

            <div class="mt-3 small text-muted">Preview response</div>
            <div class="p-2 bg-white rounded mt-1">Suggested 4-day split: Upper/Lower with progressive overload and rep ranges. Include alternate exercises if no barbell available.</div>
          </div>

          <div class="d-flex gap-2">
            <% if user_signed_in? %>
              <%= link_to "Open chat", workout_plans_path, class: "btn btn-outline-primary flex-grow-1" %>
            <% else %>
              <%= link_to "Sign up to chat", new_user_registration_path, class: "btn btn-primary flex-grow-1" %>
            <% end %>
            <%= link_to "Learn more", root_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>

      <div class="mt-3 text-center small text-muted">Minimal demo — full chat available after sign up.</div>
    </div>
  </div>
</div>

<style>
/* Keep styling minimal and compatible with existing header/footer */
.landing-hero { max-width: 1100px; }
.badge.bg-primary-subtle { background-color: rgba(13,110,253,0.08); }
.badge.text-primary-emphasis { color: #0d6efd; }
.avatar { font-weight: 700; }
</style>
