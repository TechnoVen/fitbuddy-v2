<div class="container py-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <h2>Start Workout for <%= @workout_plan.goal %></h2>

      <%= form_with model: [@workout_plan, @workout], local: true do |f| %>
        <div class="mb-3">
          <%= f.label :started_at, "Start Time", class: "form-label" %>
          <%= f.datetime_local_field :started_at, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :notes, class: "form-label" %>
          <%= f.text_area :notes, class: "form-control", rows: 3 %>
        </div>

        <div class="d-flex gap-2">
          <%= f.submit "Start Workout", class: "btn btn-primary" %>
          <%= link_to "Cancel", workout_plan_path(@workout_plan), class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
